# FEVERIS environment variables. Copy to .env.local and fill in real values.
# Never commit .env.local. This list was derived by grepping process.env in the code.

# Anthropic API key (Claude reasoning) - lib/claude.ts. https://console.anthropic.com/
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# HuggingFace read token (hosted BioNER inference) - lib/bioner.ts. https://huggingface.co/settings/tokens
HF_TOKEN=your-huggingface-token-here

# Supabase project URL - lib/supabase.ts, scripts/embedAndStore.ts. Supabase Dashboard -> Settings -> API
SUPABASE_URL=https://your-project.supabase.co

# Supabase anon (public) key, read-only retrieval at runtime - lib/supabase.ts. Dashboard -> Settings -> API
SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Supabase service-role key, ONLY for the offline corpus loader - scripts/embedAndStore.ts,
# evaluation/truncateAndVerify.ts. Server/local use only; bypasses RLS. Never expose to a browser.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Deepgram key for browser speech-to-text - app/components/VoiceToggle.tsx. https://console.deepgram.com/
# WARNING: NEXT_PUBLIC_ variables are compiled into the client JavaScript bundle, so this key is
# visible to every visitor. Use a separate, usage-limited, short-lived Deepgram key for it
# (never the same key as DEEPGRAM_API_KEY) and rotate it if you ever deploy publicly.
NEXT_PUBLIC_DEEPGRAM_API_KEY=your-browser-scoped-deepgram-key-here

# Text-to-speech provider: "deepgram" (default if unset) or "elevenlabs" - app/api/tts/route.ts
TTS_PROVIDER=deepgram

# Deepgram key for server-side Aura TTS - app/api/tts/route.ts. https://console.deepgram.com/
DEEPGRAM_API_KEY=your-deepgram-server-key-here

# Deepgram Aura voice model (default aura-asteria-en) - app/api/tts/route.ts
DEEPGRAM_TTS_VOICE=aura-asteria-en

# ElevenLabs key; only needed if TTS_PROVIDER=elevenlabs - app/api/tts/route.ts. https://elevenlabs.io/
ELEVENLABS_API_KEY=your-elevenlabs-api-key-here

# ElevenLabs voice id; only if TTS_PROVIDER=elevenlabs (a built-in default voice is used if unset)
ELEVENLABS_VOICE_ID=your-elevenlabs-voice-id-here
